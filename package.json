		"lint:php": "composer run-script lint",
		"i18n:pot": "wp i18n make-pot . languages/ai-provider-for-lm-studio.pot --domain=ai-provider-for-lm-studio --exclude=node_modules,vendor,tests",
		"lint": "npm-run-all --parallel lint:*",
		"plugin-zip": "wp-scripts plugin-zip"
	},
	"overrides": {
		"eslint": "^8.57.1",
		"minimatch": ">=3.1.3",
		"serialize-javascript": ">=7.0.3",
		"webpack-dev-server@<=5.2.0": ">=5.2.1",
		"uuid": ">=14.0.0",
		"js-yaml": "^4.1.2",
		"markdown-it": "^14.1.0",
		"@opentelemetry/core": "^2.8.0",
		"adm-zip": "^0.6.0",
		"fast-uri" : ">=3.1.3"
