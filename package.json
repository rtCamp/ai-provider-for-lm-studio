		"url": "https://github.com/rtcamp/ai-provider-for-lm-studio.git"
	},
	"engines": {
		"node": ">=22.0.0",
		"npm": ">=10.0.0"
	},
	"dependencies": {
		"@wordpress/api-fetch": "^7.52.0",
		"@wordpress/dom-ready": "^4.52.0",
		"@wordpress/i18n": "^6.25.0"
	},
	"devDependencies": {
		"@babel/core": "^7.29.0",
		"@types/react": "^18.3.31",
		"@types/react-dom": "^18.3.7",
		"@wordpress/babel-preset-default": "^8.40.0",
		"@wordpress/browserslist-config": "^6.40.0",
		"@wordpress/eslint-plugin": "^24.2.0",
		"@wordpress/scripts": "^31.5.0",
		"browserslist": "^4.28.1",
		"eslint": "^8.57.1",
		"eslint-plugin-eslint-comments": "^3.2.0",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-jest": "^27.9.0",
		"globals": "^17.8.0",
